{
  "name": "eeg-analysis",
  "version": "1.2.0",
  "description": "EEG Data Analysis Tool",
  "main": "renderer.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "package": "node package_python.js && npm run -s package-electron && npm run -s package-cleanup",
    "package-electron": "electron-builder",
    "package-cleanup": "rm -rf build && rm -rf run_app.spec && rm -rf dist-python"
  },
  "build": {
    "appId": "com.determinant.app",
    "productName": "EEG Analysis",
    "asar": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "files": [
      "renderer.js",
      "icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-python/",
        "to": "app/dist-python",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Determinant, Inc",
  "license": "ISC",
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ps-tree": "^1.2.0"
  }
}
